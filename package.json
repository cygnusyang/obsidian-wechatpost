{
  "name": "obsidian-wechatpost",
  "version": "0.1.5",
  "description": "Publish Markdown notes to WeChat Official Accounts from Obsidian (thin MCP client for wechatpost-mcp).",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "wechat",
    "publisher"
  ],
  "author": "cygnus",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.4.11",
    "tslib": "^2.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
